{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcst.local/schema/medical-3d-box/boxes-1.0.0.json",
  "title": "PCST medical 3D box annotations",
  "type": "object",
  "required": ["schema", "schema_version", "case_id", "image", "coordinate_convention", "overlap_policy", "classes", "annotations"],
  "properties": {
    "schema": {"const": "medical-3d-box"},
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "image": {
      "type": "object",
      "required": ["file", "size_ijk", "geometry"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "size_ijk": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "geometry": {
          "type": "object",
          "required": ["world_coordinate_system", "spacing_mm", "origin_lps_mm", "direction_ijk_to_lps"],
          "properties": {
            "world_coordinate_system": {"const": "LPS"},
            "spacing_mm": {
              "type": "array",
              "prefixItems": [
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "number", "exclusiveMinimum": 0},
                {"type": "number", "exclusiveMinimum": 0}
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "origin_lps_mm": {
              "type": "array",
              "prefixItems": [
                {"type": "number"},
                {"type": "number"},
                {"type": "number"}
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "direction_ijk_to_lps": {
              "type": "array",
              "prefixItems": [
                {"type": "number"}, {"type": "number"}, {"type": "number"},
                {"type": "number"}, {"type": "number"}, {"type": "number"},
                {"type": "number"}, {"type": "number"}, {"type": "number"}
              ],
              "minItems": 9,
              "maxItems": 9
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "coordinate_convention": {
      "type": "object",
      "required": ["bbox_space", "voxel_axes", "bbox_representation", "min_boundary", "max_boundary", "world_coordinate_system", "physical_unit"],
      "properties": {
        "bbox_space": {"const": "voxel_index"},
        "voxel_axes": {"const": "IJK"},
        "bbox_representation": {"const": "min_max"},
        "min_boundary": {"const": "inclusive"},
        "max_boundary": {"const": "exclusive"},
        "world_coordinate_system": {"const": "LPS"},
        "physical_unit": {"const": "mm"}
      },
      "additionalProperties": false
    },
    "overlap_policy": {"const": "allowed"},
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "lesion_id", "class_id", "geometry", "relations", "attributes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "lesion_id": {"type": ["string", "null"], "minLength": 1},
          "class_id": {"type": "integer", "minimum": 0},
          "geometry": {
            "type": "object",
            "required": ["type", "space", "bbox"],
            "properties": {
              "type": {"const": "aabb"},
              "space": {"const": "voxel_index"},
              "bbox": {
                "type": "object",
                "required": ["min_ijk", "max_ijk_exclusive"],
                "properties": {
                  "min_ijk": {
                    "type": "array",
                    "prefixItems": [
                      {"type": "integer", "minimum": 0},
                      {"type": "integer", "minimum": 0},
                      {"type": "integer", "minimum": 0}
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "max_ijk_exclusive": {
                    "type": "array",
                    "prefixItems": [
                      {"type": "integer", "minimum": 1},
                      {"type": "integer", "minimum": 1},
                      {"type": "integer", "minimum": 1}
                    ],
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "target_lesion_id"],
              "properties": {
                "type": {"type": "string", "minLength": 1},
                "target_lesion_id": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "attributes": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
